---
import Icon from "./Icon.astro";
import { SITE, NAV_LINKS } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="bg-forest-dark texture-dots-light text-cream">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="font-display text-2xl font-semibold">{SITE.name}</p>
        <p class="mt-3 max-w-sm text-base leading-relaxed text-cream/75">
          {SITE.tagline}. Diseñamos y construimos con conciencia ambiental, de la primera charla a la obra terminada.
        </p>
        <div class="mt-5 flex items-center gap-4">
          <a
            href={SITE.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 text-base text-cream/85 transition hover:text-cream"
            aria-label="Instagram de Estudio Verde"
          >
            <Icon name="instagram" class="h-5 w-5" />
            {SITE.instagramHandle}
          </a>
        </div>
      </div>

      <div>
        <p class="eyebrow text-sand-light">Navegación</p>
        <ul class="mt-4 space-y-1 text-base text-cream/80">
          {NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-11 items-center transition hover:text-cream">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow text-sand-light">Contacto</p>
        <ul class="mt-4 space-y-1 text-base text-cream/80">
          <li class="flex min-h-11 items-center gap-2">
            <Icon name="whatsapp" class="h-5 w-5 shrink-0" />
            <a href={SITE.whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center hover:text-cream">
              {SITE.whatsappDisplay}
            </a>
          </li>
          <li class="flex min-h-11 items-center gap-2">
            <Icon name="mail" class="h-5 w-5 shrink-0" />
            <a href={SITE.mailtoHref} class="inline-flex min-h-11 min-w-0 items-center break-all hover:text-cream">{SITE.email}</a>
          </li>
          <li class="flex min-h-11 items-center gap-2">
            <Icon name="map-pin" class="h-5 w-5 shrink-0" />
            <span>{SITE.city} · {SITE.locationNote}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-cream/15 pt-6 text-base text-cream/70 sm:flex-row sm:items-center">
      <p>© {year} {SITE.name}. Todos los derechos reservados.</p>
      <p>Rosario, Santa Fe, Argentina</p>
    </div>
  </div>
</footer>
