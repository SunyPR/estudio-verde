---
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const iconByCategory = {
  casas: "house",
  remodelaciones: "remodel",
  locales: "store",
  jardines: "leaf",
} as const;

const toneByCategory = {
  casas: "forest",
  remodelaciones: "terracotta",
  locales: "olive",
  jardines: "sand",
} as const;
---

<dialog id="proyecto-dialog" class="proyecto-dialog" aria-modal="true">
  <div class="dialog-sheet">
    <div class="dialog-toolbar">
      <button type="button" class="dialog-close" data-dialog-close>
        <Icon name="close" class="h-6 w-6" />
        Cerrar
      </button>
    </div>

    {
      projects.map((project) => (
        <article hidden data-dialog-project={project.id}>
          <Photo
            src={project.image}
            alt={`${project.title}, ${project.location}`}
            fit="contain"
            icon={iconByCategory[project.category]}
            tone={toneByCategory[project.category]}
            label={project.location}
          />
          <div class="px-5 pb-8 pt-5 sm:px-8">
            <p class="eyebrow">{project.location}</p>
            <h2 id={`dialog-title-${project.id}`} class="font-display mt-2 text-2xl font-semibold text-forest sm:text-3xl">
              {project.title}
            </h2>
            <p class="mt-3 text-base leading-relaxed text-ink-soft">{project.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</dialog>

<script>
  const dialog = document.getElementById("proyecto-dialog");

  if (dialog instanceof HTMLDialogElement) {
    const panels = dialog.querySelectorAll<HTMLElement>("[data-dialog-project]");

    function show(id: string) {
      let found = false;

      panels.forEach((panel) => {
        const match = panel.dataset.dialogProject === id;
        panel.toggleAttribute("hidden", !match);
        if (!match) return;
        found = true;
        const title = panel.querySelector("h2");
        if (title?.id) dialog.setAttribute("aria-labelledby", title.id);
      });

      if (!found || dialog.open) return;
      dialog.showModal();
    }

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const opener = target.closest("[data-project-open]");
      if (!(opener instanceof HTMLElement) || !opener.dataset.projectOpen) return;
      show(opener.dataset.projectOpen);
    });

    dialog.querySelector("[data-dialog-close]")?.addEventListener("click", () => {
      dialog.close();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
