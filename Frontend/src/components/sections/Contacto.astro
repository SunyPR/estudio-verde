---
import ContactButtons from "../ContactButtons.astro";
import Icon from "../Icon.astro";
import { SITE } from "../../data/site";
---

<section id="contacto" class="section-pad scroll-mt-28 mx-auto max-w-6xl px-5 sm:px-8">
  <p class="eyebrow">Contacto</p>
  <h2 class="font-display mt-3 text-3xl font-semibold text-forest sm:text-4xl">
    ¿Charlamos sobre tu proyecto?
  </h2>
  <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-soft">
    Contanos qué tenés en mente — una casa, una remodelación, un local o un jardín.
    La cita se coordina por el WhatsApp del estudio. Si no tenés WhatsApp, escribinos
    por mail.
  </p>

  <ContactButtons class="mt-8" />

  <div class="mt-10 flex max-w-lg items-start gap-3 rounded-xl border border-forest/15 bg-cream-dark/50 p-4">
    <Icon name="map-pin" class="mt-0.5 h-5 w-5 shrink-0 text-terracotta-dark" />
    <div>
      <p class="font-medium text-ink">{SITE.city}</p>
      <p class="text-base text-ink-soft">{SITE.locationNote}</p>
    </div>
  </div>
</section>
