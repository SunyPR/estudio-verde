---
import ContactButtons from "../ContactButtons.astro";
import Icon from "../Icon.astro";
import { SITE } from "../../data/site";
---

<section id="contacto" class="section-pad scroll-mt-28 mx-auto max-w-6xl px-5 sm:px-8">
  <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class="eyebrow">Contacto</p>
      <h2 class="font-display mt-3 text-3xl font-semibold text-forest sm:text-4xl">
        ¿Charlamos sobre tu proyecto?
      </h2>
      <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-soft">
        Contanos qué tenés en mente — una casa, una remodelación, un local o un jardín.
        La cita se coordina por el WhatsApp del estudio. Si no tenés WhatsApp, escribinos
        por mail.
      </p>

      <ContactButtons class="mt-8" />

      <div class="mt-10 flex items-start gap-3 rounded-xl border border-forest/15 bg-cream-dark/50 p-4">
        <Icon name="map-pin" class="mt-0.5 h-5 w-5 shrink-0 text-terracotta-dark" />
        <div>
          <p class="font-medium text-ink">{SITE.city}</p>
          <p class="text-base text-ink-soft">{SITE.locationNote}</p>
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-forest/10 bg-forest/5 p-8">
      <p class="font-display text-lg font-semibold text-forest">Un solo lugar, sin perder nada</p>
      <p class="mt-3 text-base leading-relaxed text-ink-soft">
        Ese lugar es el WhatsApp del estudio. Las consultas de esta web llegan ahí,
        sin intermediarios y sin perderse entre mensajes.
      </p>

      <ul class="mt-6 space-y-4">
        <li class="flex min-h-11 items-center gap-3 text-base text-ink">
          <Icon name="whatsapp" class="h-5 w-5 shrink-0 text-forest" />
          <span>{SITE.whatsappDisplay}</span>
        </li>
        <li class="flex min-h-11 items-center gap-3 text-base text-ink">
          <Icon name="mail" class="h-5 w-5 shrink-0 text-forest" />
          <span class="min-w-0 break-all">{SITE.email}</span>
        </li>
      </ul>
    </div>
  </div>
</section>
