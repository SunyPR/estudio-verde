---
import Icon from "../Icon.astro";
import Photo from "../Photo.astro";
import { SERVICES } from "../../data/services";
---

<section id="servicios" class="section-pad scroll-mt-28 mx-auto max-w-6xl px-5 sm:px-8">
  <div class="max-w-2xl">
    <p class="eyebrow">Lo que ofrecemos</p>
    <h2 class="font-display mt-3 text-balance text-3xl font-semibold text-forest sm:text-4xl">
      Arquitectura y paisajismo, de la mano
    </h2>
    <p class="mt-5 text-base leading-relaxed text-ink-soft">
      No somos solo los de las plantas — también hacemos la obra completa. Y no somos
      solo arquitectura — también cuidamos cada espacio verde.
    </p>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      SERVICES.map((servicio, index) => (
        <a
          href={servicio.href}
          data-reveal
          style={`--reveal-delay: ${index * 90}ms`}
          class="group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-forest/10 bg-cream-dark/50 transition hover:border-forest/30 hover:bg-cream-dark"
        >
          <Photo
            src={servicio.image}
            alt={servicio.imageAlt}
            icon={servicio.icon}
            tone={servicio.tone}
            label={servicio.title}
            class="aspect-[4/3] w-full"
          />
          <span class="flex flex-1 flex-col p-5 sm:p-6">
            <span class="flex min-w-0 items-center gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-terracotta/15 text-terracotta-dark">
                <Icon name={servicio.icon} class="h-5 w-5" />
              </span>
              <span class="min-w-0 font-display text-lg font-semibold leading-snug text-forest">{servicio.title}</span>
            </span>
            <span class="mt-3 block text-base leading-relaxed text-ink-soft">{servicio.text}</span>
            <span class="mt-4 inline-flex min-h-11 flex-wrap items-center gap-2 text-base font-semibold text-forest">
              {servicio.linkLabel}
              <Icon name="arrow-right" class="h-4 w-4 shrink-0 transition group-hover:translate-x-1" />
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>
