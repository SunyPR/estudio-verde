---
// -----------------------------------------------------------------------
// Icon.astro — set de íconos de línea, estilo "dibujado a mano" simple.
// Se usan sobre todo donde todavía no hay fotos reales (Servicios, Proceso)
// para que esas secciones transmitan calidez en vez de verse vacías.
// Cuando lleguen fotos reales de cada rubro, pueden reemplazar al ícono.
// -----------------------------------------------------------------------
interface Props {
  name:
    | "house"
    | "remodel"
    | "store"
    | "leaf"
    | "chat"
    | "compass"
    | "build"
    | "handshake"
    | "whatsapp"
    | "mail"
    | "instagram"
    | "map-pin"
    | "menu"
    | "close"
    | "arrow-right";
  class?: string;
  id?: string;
}

const { name, class: className = "w-6 h-6", id } = Astro.props;
---

{
  name === "house" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 23 23.3 8.5a1.8 1.8 0 0 1 2.4 0L42 23" stroke="currentColor" stroke-width="2.2" />
      <path d="M11 19.5V39a1.5 1.5 0 0 0 1.5 1.5H19V30a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v10.5h6.5A1.5 1.5 0 0 0 37 39V19.5" stroke="currentColor" stroke-width="2.2" />
      <path d="M30 15.5V9h5v10.8" stroke="currentColor" stroke-width="2.2" />
    </svg>
  )
}

{
  name === "remodel" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <path d="M27.5 8.5 39.5 20.5 23 37C21.5 38.5 18 39.5 15 40c.5-3 1.5-6.5 3-8L34 16.5" stroke="currentColor" stroke-width="2.2" />
      <path d="M24 12 36 24" stroke="currentColor" stroke-width="2.2" />
      <path d="M8 40h14" stroke="currentColor" stroke-width="2.2" />
    </svg>
  )
}

{
  name === "store" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 18 10.5 8h27L40 18" stroke="currentColor" stroke-width="2.2" />
      <path d="M8 18a4 4 0 0 0 8 0 4 4 0 0 0 8 0 4 4 0 0 0 8 0 4 4 0 0 0 8 0" stroke="currentColor" stroke-width="2.2" />
      <path d="M10 21.5V39a1 1 0 0 0 1 1h26a1 1 0 0 0 1-1V21.5" stroke="currentColor" stroke-width="2.2" />
      <path d="M19 40V29a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v11" stroke="currentColor" stroke-width="2.2" />
    </svg>
  )
}

{
  name === "leaf" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <path d="M38 10c1.2 11-2 20-9.5 27.5C21 45 11 42 9 36c-2.3-7 1-16 9-21.5C25.5 9 33.5 7 38 10Z" stroke="currentColor" stroke-width="2.2" />
      <path d="M35 13c-7 6-13.5 13-21 23" stroke="currentColor" stroke-width="2" />
    </svg>
  )
}

{
  name === "chat" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 13.5A4.5 4.5 0 0 1 12.5 9h23A4.5 4.5 0 0 1 40 13.5V27a4.5 4.5 0 0 1-4.5 4.5H21l-9 7v-7h-2A4.5 4.5 0 0 1 8 27Z" stroke="currentColor" stroke-width="2.2" />
      <path d="M16 18h16M16 23.5h10" stroke="currentColor" stroke-width="2" />
    </svg>
  )
}

{
  name === "compass" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2.2" />
      <path d="M29.5 18.5 25.8 27 17.5 29.5l3.7-8.5 8.3-2.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      <circle cx="24" cy="24" r="1.6" fill="currentColor" />
    </svg>
  )
}

{
  name === "build" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 40 18 28" stroke="currentColor" stroke-width="2.2" />
      <path d="M15 25l3-3 8 8-3 3Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
      <path d="M24.5 15.5 29 11a6 6 0 0 1 8 8l-4.5 4.5" stroke="currentColor" stroke-width="2.2" />
      <path d="M27 18l6 6" stroke="currentColor" stroke-width="2.2" />
    </svg>
  )
}

{
  name === "handshake" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 20l7-5 8 5-5 7-10-3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      <path d="M44 20l-7-5-8 5 5 7 10-3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      <path d="M19 20l6 6 6-6" stroke="currentColor" stroke-width="2.2" />
      <path d="M14 23l6.5 6.5a2.3 2.3 0 0 0 3.3 0M34 23l-6.5 6.5a2.3 2.3 0 0 1-3.3 0" stroke="currentColor" stroke-width="2.2" />
    </svg>
  )
}

{
  name === "whatsapp" && (
    <svg id={id} viewBox="0 0 32 32" fill="currentColor" class={className}>
      <path d="M16.04 3C9.1 3 3.46 8.6 3.46 15.5c0 2.56.74 4.95 2.03 6.96L4 29l6.75-1.76a12.9 12.9 0 0 0 5.29 1.12h.01c6.94 0 12.58-5.6 12.58-12.5C28.63 8.6 23 3 16.04 3Zm0 22.9h-.01a10.4 10.4 0 0 1-5.3-1.46l-.38-.22-3.78.99 1.01-3.66-.25-.38a10.3 10.3 0 0 1-1.6-5.57c0-5.72 4.68-10.37 10.42-10.37 2.78 0 5.4 1.08 7.37 3.04a10.26 10.26 0 0 1 3.05 7.33c0 5.72-4.68 10.3-10.53 10.3Zm5.73-7.72c-.31-.16-1.84-.9-2.12-1-.28-.1-.49-.16-.69.16-.2.31-.79 1-.97 1.2-.18.21-.36.23-.67.08-.31-.16-1.3-.48-2.47-1.52-.91-.81-1.53-1.81-1.71-2.12-.18-.31-.02-.48.14-.64.14-.14.31-.36.46-.54.16-.18.21-.31.31-.52.1-.21.05-.39-.03-.54-.08-.16-.69-1.67-.95-2.28-.25-.6-.5-.52-.69-.53-.18-.01-.39-.01-.6-.01-.21 0-.54.08-.83.39-.28.31-1.1 1.08-1.1 2.63 0 1.56 1.13 3.06 1.28 3.27.16.21 2.21 3.38 5.37 4.6 3.15 1.23 3.15.82 3.72.77.57-.05 1.84-.75 2.1-1.47.26-.73.26-1.35.18-1.47-.08-.13-.28-.21-.59-.37Z" />
    </svg>
  )
}

{
  name === "mail" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="11" width="36" height="26" rx="3" stroke="currentColor" stroke-width="2.2" />
      <path d="M8 14l14.3 11a2.5 2.5 0 0 0 3.1 0L40 14" stroke="currentColor" stroke-width="2.2" />
    </svg>
  )
}

{
  name === "instagram" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <rect x="7" y="7" width="34" height="34" rx="9" stroke="currentColor" stroke-width="2.2" />
      <circle cx="24" cy="24" r="8.5" stroke="currentColor" stroke-width="2.2" />
      <circle cx="33" cy="15" r="1.8" fill="currentColor" />
    </svg>
  )
}

{
  name === "map-pin" && (
    <svg id={id} viewBox="0 0 48 48" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 42s13-11.6 13-21.5S31.2 6 24 6 11 11.1 11 20.5 24 42 24 42Z" stroke="currentColor" stroke-width="2.2" />
      <circle cx="24" cy="20" r="5" stroke="currentColor" stroke-width="2.2" />
    </svg>
  )
}

{
  name === "menu" && (
    <svg id={id} viewBox="0 0 24 24" fill="none" class={className} stroke-linecap="round">
      <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" />
    </svg>
  )
}

{
  name === "close" && (
    <svg id={id} viewBox="0 0 24 24" fill="none" class={className} stroke-linecap="round">
      <path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="2" />
    </svg>
  )
}

{
  name === "arrow-right" && (
    <svg id={id} viewBox="0 0 24 24" fill="none" class={className} stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 12h16M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" />
    </svg>
  )
}
